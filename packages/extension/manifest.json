{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "0.1.0",
  "default_locale": "en",
  "permissions": [
    "tabs",
    "activeTab",
    "debugger",
    "scripting",
    "storage",
    "alarms",
    "tabGroups",
    "tabCapture",
    "offscreen",
    "windows",
    "nativeMessaging",
    "history",
    "contentSettings"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content/meet-audio-prehook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content/virtual-camera.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
